@page "/Account/SendSecurityCode"
@using Microsoft.AspNetCore.Mvc.Localization
@using Volo.Abp.Account.Localization
@model MainPlatform.Blazor.Pages.Account.SendSecurityCodeModel
@inject IHtmlLocalizer<AccountResource> L

@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@L["TwoFactorAuthentication"]</title>
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;600&display=swap" rel="stylesheet">
    <style>
        :root {
            --rz-primary: #4f46e5;
            --rz-primary-lighter: #818cf8;
            --rz-primary-darker: #4338ca;
            --rz-base-background-color: #f8fafc;
            --rz-text-color: #1e293b;
            --rz-text-secondary-color: #64748b;
            --rz-border-color: #e2e8f0;
            --rz-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.1), 0 4px 6px -2px rgba(0, 0, 0, 0.05);
            --rz-border-radius: 12px;
        }

        body {
            font-family: 'Outfit', sans-serif;
            margin: 0;
            min-height: 100vh;
            display: flex;
            justify-content: center;
            align-items: center;
            background-color: var(--rz-base-background-color);
            background-image: radial-gradient(at 0% 0%, rgba(79, 70, 229, 0.05) 0px, transparent 50%), 
                              radial-gradient(at 100% 0%, rgba(129, 140, 248, 0.05) 0px, transparent 50%);
            color: var(--rz-text-color);
        }

        .auth-card {
            background: white;
            padding: 2.5rem;
            border-radius: 20px;
            box-shadow: var(--rz-shadow);
            width: 100%;
            max-width: 440px;
            border: 1px solid var(--rz-border-color);
            text-align: center;
            animation: slideUp 0.5s ease-out;
        }

        .auth-logo {
            font-size: 2.5rem;
            color: var(--rz-primary);
            margin-bottom: 1.5rem;
            display: inline-block;
        }

        h2 {
            margin: 0 0 0.5rem 0;
            font-size: 1.75rem;
            font-weight: 700;
            color: var(--rz-text-color);
        }

        .subtitle {
            font-size: 1rem;
            color: var(--rz-text-secondary-color);
            margin-bottom: 2rem;
        }

        .form-group {
            margin-bottom: 1.25rem;
            text-align: left;
        }

        label {
            display: block;
            margin-bottom: 0.5rem;
            font-weight: 600;
            color: var(--rz-text-color);
            font-size: 0.9rem;
        }

        select {
            width: 100%;
            padding: 12px 16px;
            border: 2px solid var(--rz-border-color);
            border-radius: var(--rz-border-radius);
            font-size: 1rem;
            transition: all 0.2s ease;
            box-sizing: border-box;
            background: #fff;
            color: var(--rz-text-color);
            appearance: none;
            background-image: url("data:image/svg+xml;charset=UTF-8,%3csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='%2364748b' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'%3e%3cpolyline points='6 9 12 15 18 9'%3e%3c/polyline%3e%3c/svg%3e");
            background-repeat: no-repeat;
            background-position: right 1rem center;
            background-size: 1em;
        }

        select:focus {
            border-color: var(--rz-primary-lighter);
            outline: none;
            box-shadow: 0 0 0 4px rgba(79, 70, 229, 0.1);
        }

        .btn-primary {
            width: 100%;
            padding: 14px;
            background: var(--rz-primary);
            color: white;
            border: none;
            border-radius: 50px;
            font-size: 1rem;
            font-weight: 700;
            cursor: pointer;
            transition: all 0.3s ease;
            box-shadow: 0 4px 6px rgba(79, 70, 229, 0.2);
        }

        .btn-primary:hover {
            background: var(--rz-primary-darker);
            transform: translateY(-1px);
            box-shadow: 0 6px 12px rgba(79, 70, 229, 0.3);
        }

        .alert-danger {
            color: #991b1b;
            background: #fef2f2;
            padding: 1rem;
            border-radius: var(--rz-border-radius);
            margin-bottom: 1.5rem;
            font-size: 0.9rem;
            text-align: left;
            border-left: 4px solid #ef4444;
        }

        @@keyframes slideUp {
            from { opacity: 0; transform: translateY(20px); }
            to { opacity: 1; transform: translateY(0); }
        }
    </style>
</head>
<body>
    <div class="auth-card">
        <div class="auth-logo">
            <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path></svg>
        </div>

        <h2>@L["TwoFactorAuthentication"]</h2>
        <p class="subtitle">@L["SendSecurityCode"]</p>

        @if (!ModelState.IsValid)
        {
             <div class="alert-danger">
                @foreach (var modelState in ModelState.Values)
                {
                    foreach (var error in modelState.Errors)
                    {
                        <div>• @error.ErrorMessage</div>
                    }
                }
            </div>
        }

        <form method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" name="ReturnUrl" value="@Model.ReturnUrl" />
            <input type="hidden" name="ReturnUrlHash" value="@Model.ReturnUrlHash" />
            <input type="hidden" name="RememberMe" value="@Model.RememberMe" />

            <div class="form-group">
                <label for="SelectedProvider">@L["SelectedProvider"]</label>
                <select id="SelectedProvider" name="SelectedProvider" required>
                    @if (Model.Providers != null)
                    {
                        @foreach (var provider in Model.Providers)
                        {
                            <option value="@provider.Value">@provider.Text</option>
                        }
                    }
                </select>
            </div>

            <button type="submit" class="btn-primary">@L["Send"]</button>
        </form>
    </div>
</body>
</html>
