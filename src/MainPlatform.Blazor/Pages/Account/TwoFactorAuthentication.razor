@code {
    private enum TwoFactorStep { None, Selection, PasswordVerification, SetupAuthenticator, SetupSMS, SetupEmail }
    private enum TwoFactorOption { Authenticator, SMS, Email }

    private bool isLoading = true;
    private bool isTwoFactorEnabled = false;
    private TwoFactorStep currentStep = TwoFactorStep.None;
    private TwoFactorOption selectedOption = TwoFactorOption.Authenticator;
    private string confirmPassword = string.Empty;
    private string errorMessage = string.Empty;


    // Authenticator Data
    private string qrCodeUri = string.Empty;
    private string sharedKey = string.Empty;
    private string verificationCode = string.Empty;
    private IEnumerable<string>? recoveryCodes;
    private string successMessage = string.Empty;
    
    // SMS Data
    private string smsPhoneNumber = string.Empty;
    private string smsVerificationCode = string.Empty;
    private bool smsCodeSent = false;
    private bool showPhoneNumberInput = false;

    // Email Data
    private string emailAddress = string.Empty;
    private string emailVerificationCode = string.Empty;
    private bool emailCodeSent = false;
    
    // Password visibility
    private bool showPassword = false;

    protected override async Task OnInitializedAsync()
    {
        await LoadTwoFactorStatus();
        isLoading = false;
    }

    private async Task LoadTwoFactorStatus()
    {
        try
        {
            var status = await TwoFactorAppService.GetStatusAsync();
            isTwoFactorEnabled = status.IsEnabled;
            if (!isTwoFactorEnabled)
            {
                currentStep = TwoFactorStep.Selection;
            }
            else
            {
                currentStep = TwoFactorStep.None;
            }
            
            var smsStatus = await TwoFactorAppService.GetSmsStatusAsync();
            smsPhoneNumber = smsStatus.PhoneNumber ?? string.Empty;

            var emailStatus = await TwoFactorAppService.GetEmailStatusAsync();
            emailAddress = emailStatus.Email ?? string.Empty;
        }
        catch (Exception)
        {
            errorMessage = L["ErrorLoadingData"];
        }
    }

    private void SelectOption(TwoFactorOption option)
    {
        selectedOption = option;
    }

    private void ProceedToPassword()
    {
        currentStep = TwoFactorStep.PasswordVerification;
        errorMessage = string.Empty;
        confirmPassword = string.Empty;
        showPassword = false;
    }
    
    private void TogglePasswordVisibility()
    {
        showPassword = !showPassword;
    }

    private async Task VerifyPassword()
    {
        if (string.IsNullOrWhiteSpace(confirmPassword))
        {
            errorMessage = L["PasswordRequired"];
            return;
        }

        isLoading = true;
        try
        {
            var isValid = await TwoFactorAppService.CheckPasswordAsync(confirmPassword);
            if (isValid)
            {
                if (selectedOption == TwoFactorOption.Authenticator)
                {
                    await EnableTwoFactor();
                }
                else if (selectedOption == TwoFactorOption.SMS)
                {
                    currentStep = TwoFactorStep.SetupSMS;
                    smsCodeSent = false;
                    isLoading = false;
                }
                else if (selectedOption == TwoFactorOption.Email)
                {
                    currentStep = TwoFactorStep.SetupEmail;
                    emailCodeSent = false;
                    isLoading = false;
                }
            }
            else
            {
                errorMessage = L["InvalidPassword"];
                isLoading = false; 
            }
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
            isLoading = false;
        }
    }

    private async Task EnableTwoFactor()
    {
        try
        {
            var setup = await TwoFactorAppService.SetupAsync();
            sharedKey = setup.SharedKey;
            qrCodeUri = setup.QrCodeUri;
            currentStep = TwoFactorStep.SetupAuthenticator;
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            isLoading = false;
            confirmPassword = string.Empty; // Clear password
        }
    }
    
    private async Task SendSmsCode()
    {
        if (string.IsNullOrWhiteSpace(smsPhoneNumber))
        {
            errorMessage = L["PhoneNumberRequired"];
            return;
        }

        isLoading = true;
        errorMessage = string.Empty;
        try
        {
            await TwoFactorAppService.SendSmsCodeAsync(new SendSmsCodeDto { PhoneNumber = smsPhoneNumber });
            smsCodeSent = true;
            NotificationService.Notify(NotificationSeverity.Success, L["Success"], L["VerificationCodeSent"]);
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task VerifySmsCode()
    {
        if (string.IsNullOrWhiteSpace(smsVerificationCode))
        {
            errorMessage = L["VerificationCodeRequired"];
            return;
        }

        isLoading = true;
        errorMessage = string.Empty;
        try
        {
            var result = await TwoFactorAppService.VerifySmsAndEnableAsync(new VerifySmsCodeDto 
            { 
                PhoneNumber = smsPhoneNumber, 
                Code = smsVerificationCode 
            });
            recoveryCodes = result.RecoveryCodes;
            
            isTwoFactorEnabled = true;
            currentStep = TwoFactorStep.None;
            smsCodeSent = false;
            smsVerificationCode = string.Empty;
            
            NotificationService.Notify(NotificationSeverity.Success, L["Success"], L["TwoFactorEnabledSuccessfully"]);
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task VerifyAndEnableTwoFactor()
    {
        try
        {
            errorMessage = string.Empty;
            
            if (string.IsNullOrWhiteSpace(verificationCode))
            {
                errorMessage = L["VerificationCodeRequired"];
                return;
            }

            var result = await TwoFactorAppService.VerifyAndEnableAsync(new VerifyTwoFactorDto { Code = verificationCode });
            recoveryCodes = result.RecoveryCodes;
            
            isTwoFactorEnabled = true;
            currentStep = TwoFactorStep.None;
            qrCodeUri = string.Empty;
            verificationCode = string.Empty;
            
            NotificationService.Notify(NotificationSeverity.Success, L["Success"], L["TwoFactorEnabledSuccessfully"]);
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
    }

    private async Task DisableTwoFactor()
    {
        try
        {
            await TwoFactorAppService.DisableAsync();
            isTwoFactorEnabled = false;
            currentStep = TwoFactorStep.Selection;
            NotificationService.Notify(NotificationSeverity.Success, L["Success"], L["TwoFactorDisabledSuccessfully"]);
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
    }

    private void CancelSetup()
    {
        currentStep = TwoFactorStep.Selection;
        qrCodeUri = string.Empty;
        sharedKey = string.Empty;
        verificationCode = string.Empty;
        smsVerificationCode = string.Empty;
        smsCodeSent = false;
        emailVerificationCode = string.Empty;
        emailCodeSent = false;
        errorMessage = string.Empty;
    }

    private async Task SendEmailCode()
    {
        isLoading = true;
        errorMessage = string.Empty;
        try
        {
            await TwoFactorAppService.SendEmailCodeAsync(new SendEmailCodeDto { Email = emailAddress });
            emailCodeSent = true;
            NotificationService.Notify(NotificationSeverity.Success, L["Success"], L["VerificationCodeSent"]);
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task VerifyEmailCode()
    {
        if (string.IsNullOrWhiteSpace(emailVerificationCode))
        {
            errorMessage = L["VerificationCodeRequired"];
            return;
        }

        isLoading = true;
        errorMessage = string.Empty;
        try
        {
            var result = await TwoFactorAppService.VerifyEmailAndEnableAsync(new VerifyEmailCodeDto 
            { 
                Email = emailAddress, 
                Code = emailVerificationCode 
            });
            recoveryCodes = result.RecoveryCodes;
            
            isTwoFactorEnabled = true;
            currentStep = TwoFactorStep.None;
            emailCodeSent = false;
            emailVerificationCode = string.Empty;
            
            NotificationService.Notify(NotificationSeverity.Success, L["Success"], L["TwoFactorEnabledSuccessfully"]);
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            isLoading = false;
        }
    }
}
